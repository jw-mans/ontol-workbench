-- ==============================================================
-- Базовые типы
-- ==============================================================

ТИП_ДАННЫХ BoolExpr
КОНЕЦ ТИП_ДАННЫХ

ТИП_ДАННЫХ Expr
КОНЕЦ ТИП_ДАННЫХ

ТИП_ДАННЫХ Value
КОНЕЦ ТИП_ДАННЫХ

ТИП_ДАННЫХ Type
КОНЕЦ ТИП_ДАННЫХ

-- ==============================================================
-- Перечисления
-- ==============================================================

ПЕРЕЧИСЛЕНИЕ I_Kind
  event
  action
  condition
  assertion
КОНЕЦ ПЕРЕЧИСЛЕНИЕ

ПЕРЕЧИСЛЕНИЕ I_Sort
  linked
  private
  public
КОНЕЦ ПЕРЕЧИСЛЕНИЕ

-- ==============================================================
-- Основные структурные типы (значения)
-- ==============================================================

ТИП_ДАННЫХ InterfaceLink
АТРИБУТЫ
  + a : String
  + p : String
КОНЕЦ ТИП_ДАННЫХ

ТИП_ДАННЫХ Interface
АТРИБУТЫ
  + kind : I_Kind
  + sort : I_Sort
  + link : InterfaceLink
КОНЕЦ ТИП_ДАННЫХ

ТИП_ДАННЫХ Var
АТРИБУТЫ
  + v : Value
  + t : Type
  + r : Boolean
КОНЕЦ ТИП_ДАННЫХ

-- ==============================================================
-- Переходы: объединение (union with tagged types)
-- ==============================================================

КЛАСС TransitionBody АБСТРАКТНЫЙ
КОНЕЦ КЛАСС

ТИП_ДАННЫХ Loop
АТРИБУТЫ
  + b : BoolExpr
КОНЕЦ ТИП_ДАННЫХ

ТИП_ДАННЫХ Direct
АТРИБУТЫ
  + f : Effect
  + s : String
КОНЕЦ ТИП_ДАННЫХ

КЛАСС Choice
АТРИБУТЫ
  + c : BoolExpr
  + f1 : Effect
  + s1 : String
  + f0 : Effect
  + s0 : String
КОНЕЦ КЛАСС

КЛАСС Trigger
АТРИБУТЫ
  + i : String
  + n : Integer
  + X [0..*] : String
КОНЕЦ КЛАСС

КЛАСС Transition
АТРИБУТЫ
  + t : Trigger
  + m : TransitionBody
КОНЕЦ КЛАСС

-- ==============================================================
-- Действия: объединение (union with tagged types)
-- ==============================================================

КЛАСС Action АБСТРАКТНЫЙ
КОНЕЦ КЛАСС

КЛАСС Call
АТРИБУТЫ
  + i : String
  + n : Integer
  + X [0..*] : Expr
КОНЕЦ КЛАСС

КЛАСС Assign
АТРИБУТЫ
  + v : String
  + x : Expr
КОНЕЦ КЛАСС

ТИП_ДАННЫХ Effect
АТРИБУТЫ
  + n : Integer
  + A [0..*] : Action
КОНЕЦ ТИП_ДАННЫХ

-- ==============================================================
-- Автоматы и программа
-- ==============================================================

КЛАСС State
АТРИБУТЫ
  + transitions [0..*] : Transition
КОНЕЦ КЛАСС

КЛАСС Auto_Obj
АТРИБУТЫ
  + s : String
  + V [0..*] : Var
  + P [0..*] : Interface
  + S [0..*] : State
КОНЕЦ КЛАСС

КЛАСС CIAO_Prog
АТРИБУТЫ
  + automata [0..*] : Auto_Obj
КОНЕЦ КЛАСС

-- Событие — отдельная сущность метамодели
КЛАСС Event
АТРИБУТЫ
  + e : String
  + a : String
  + n : Integer
  + X [0..*] : Value
КОНЕЦ КЛАСС

-- ==============================================================
-- Связи между классификаторами
-- ==============================================================

-- Наследование: типы переходов
ОБОБЩЕНИЕ Loop -> TransitionBody
ОБОБЩЕНИЕ Direct -> TransitionBody
ОБОБЩЕНИЕ Choice -> TransitionBody

-- Наследование: типы действий
ОБОБЩЕНИЕ Call -> Action
ОБОБЩЕНИЕ Assign -> Action

-- Композиция: программа содержит автоматы
КОМПОЗИЦИЯ CIAO_Prog [1] : program -- Auto_Obj [0..*] : automata

-- Композиция: автомат содержит переменные, интерфейсы и состояния
КОМПОЗИЦИЯ Auto_Obj [1] : automaton -- Var [0..*] : variables
КОМПОЗИЦИЯ Auto_Obj [1] : automaton -- Interface [0..*] : interfaces
КОМПОЗИЦИЯ Auto_Obj [1] : automaton -- State [0..*] : states

-- Композиция: состояние содержит переходы
КОМПОЗИЦИЯ State [1] : state -- Transition [0..*] : transitions

-- Композиция: переход содержит триггер и тело перехода
КОМПОЗИЦИЯ Transition [1] : transition -- Trigger [1] : trigger
КОМПОЗИЦИЯ Transition [1] : transition -- TransitionBody [1] : body

-- Композиция: интерфейс содержит ссылку на связанный интерфейс
КОМПОЗИЦИЯ Interface [1] : interface -- InterfaceLink [0..1] : link

-- Композиция: эффект содержит набор действий
КОМПОЗИЦИЯ Effect [1] : effect -- Call [0..*] : actions
КОМПОЗИЦИЯ Effect [1] : effect -- Assign [0..*] : actions

-- Зависимость: событие связано с объектом-автоматом
ЗАВИСИМОСТЬ Event -> Auto_Obj invoke

-- Зависимость: триггер использует интерфейс
ЗАВИСИМОСТЬ Trigger -> Interface invoke
