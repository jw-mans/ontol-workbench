SECRET=SUPER-SECRET-KEY-THAT-YOU-NEED-TO-CHANGE

POSTGRES_USER=ontol
POSTGRES_PASSWORD=ontol
POSTGRES_DB=ontol

CORS_ORIGINS=["http://localhost:5173"]

# AI_ENABLED=true
# OLLAMA_URL=http://ollama:11434
# AI_MODEL=llama3

# --- Объектное хранилище (S3/MinIO) для артефактов рендера ---
# Локально: подними оверлей docker-compose.minio.yml — дефолтов ниже достаточно.
# В ПРОДЕ укажи удалённый MinIO (раскомментируй и заполни):
# S3_ENDPOINT_URL=https://minio.internal:9000          # внутренний адрес (заливка/HEAD)
# S3_PUBLIC_ENDPOINT_URL=https://s3.example.com         # публичный адрес для presigned-ссылок
#                                                        # (браузеро-доступный; пусто = S3_ENDPOINT_URL)
# S3_ACCESS_KEY=CHANGE-ME
# S3_SECRET_KEY=CHANGE-ME
# S3_BUCKET=ontol-artifacts
# S3_REGION=us-east-1
# S3_SECURE=true
# Важно: у публичного MinIO включить CORS для origin фронта, иначе fetch(svg_url)
# упрётся в CORS. MinIO: MINIO_API_CORS_ALLOW_ORIGIN=https://app.example.com
# (S3_CORS_ORIGIN — для локального оверлея).
